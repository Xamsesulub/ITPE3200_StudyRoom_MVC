@model MVC.ViewModels.RoomsViewModel
@{
    ViewData["Title"] = "Finn rom";
}

<div class="mb-4">
    <h1>Finn grupperom</h1>
    <p class="text-secondary">Filtrer rom etter behovene dine.</p>
</div>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="building" class="form-label">Bygg</label>
            <input id="building" name="building" value="@Model.Building" class="form-control"
                   placeholder="For eksempel P35" />
        </div>

        <div class="col-md-2">
            <label for="floor" class="form-label">Etasje</label>
            <input id="floor" name="floor" value="@Model.Floor" type="number" min="0" class="form-control" />
        </div>

        <div class="col-md-3">
            <label for="minimumCapacity" class="form-label">Minimum kapasitet</label>
            <input id="minimumCapacity" name="minimumCapacity" value="@Model.MinimumCapacity"
                   type="number" min="1" class="form-control" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Søk</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Nullstill</a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-4 mt-3">
        <div class="form-check">
            <input id="hasScreen" name="hasScreen" value="true" type="checkbox"
                   class="form-check-input" checked="@Model.HasScreen" />
            <label for="hasScreen" class="form-check-label">Skjerm</label>
        </div>

        <div class="form-check">
            <input id="hasWhiteboard" name="hasWhiteboard" value="true" type="checkbox"
                   class="form-check-input" checked="@Model.HasWhiteboard" />
            <label for="hasWhiteboard" class="form-check-label">Whiteboard</label>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Tilgjengelige rom</h2>
    <span class="text-secondary">@Model.Rooms.Count rom funnet</span>
</div>

@if (Model.Rooms.Count == 0)
{
    <div class="alert alert-info" role="status">
        Ingen rom passer med filtrene. Prøv å endre søket.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Bygg</th>
                    <th>Etasje</th>
                    <th>Kapasitet</th>
                    <th>Skjerm</th>
                    <th>Whiteboard</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Rooms)
                {
                    <tr>
                        <td>@room.RoomBuilding</td>
                        <td>@room.RoomFloor</td>
                        <td>@room.RoomCapacity personer</td>
                        <td>@(room.RoomScreen ? "Ja" : "Nei")</td>
                        <td>@(room.RoomWhiteboard ? "Ja" : "Nei")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@room.RoomId"
                               class="btn btn-outline-primary btn-sm">Detaljer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
