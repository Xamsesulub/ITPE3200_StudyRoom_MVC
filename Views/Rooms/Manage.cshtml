@model MVC.ViewModels.RoomsViewModel
@{
    ViewData["Title"] = "Administrer rom";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Administrer rom</h1>
        <p class="text-secondary mb-0">Registrer, rediger eller slett grupperom.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrer nytt rom</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Rooms.Count == 0)
{
    <p>Ingen rom registrert ennå.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Rom</th>
                    <th>Bygg</th>
                    <th>Etasje</th>
                    <th>Kapasitet</th>
                    <th>Skjerm</th>
                    <th>Whiteboard</th>
                    <th>Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Rooms)
                {
                    <tr>
                        <td>@room.RoomId</td>
                        <td>@room.RoomBuilding</td>
                        <td>@room.RoomFloor</td>
                        <td>@room.RoomCapacity</td>
                        <td>@(room.RoomScreen ? "Ja" : "Nei")</td>
                        <td>@(room.RoomWhiteboard ? "Ja" : "Nei")</td>
                        <td class="d-flex gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@room.RoomId"
                               class="btn btn-outline-primary btn-sm">Detaljer</a>
                            <a asp-action="Edit" asp-route-id="@room.RoomId"
                               class="btn btn-outline-secondary btn-sm">Rediger</a>
                            <a asp-action="Delete" asp-route-id="@room.RoomId"
                               class="btn btn-outline-danger btn-sm">Slett</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
