@model MVC.Models.RoomsModel
@{
    ViewData["Title"] = "Romdetaljer";
}

<h1>Romdetaljer</h1>

<div class="card" style="max-width: 36rem;">
    <div class="card-body">
        <h2 class="card-title h4">@Model.RoomBuilding</h2>
        <dl class="row mb-0">
            <dt class="col-sm-5">Etasje</dt>
            <dd class="col-sm-7">@Model.RoomFloor</dd>

            <dt class="col-sm-5">Kapasitet</dt>
            <dd class="col-sm-7">@Model.RoomCapacity personer</dd>

            <dt class="col-sm-5">Skjerm</dt>
            <dd class="col-sm-7">@(Model.RoomScreen ? "Ja" : "Nei")</dd>

            <dt class="col-sm-5">Whiteboard</dt>
            <dd class="col-sm-7">@(Model.RoomWhiteboard ? "Ja" : "Nei")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Table" class="btn btn-outline-secondary">Tilbake til Finn rom</a>
</div>
