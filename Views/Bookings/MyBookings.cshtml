@model MVC.ViewModels.MyBookingsViewModel
@{
    ViewData["Title"] = "Mine reservasjoner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Mine reservasjoner</h2>
    <a asp-controller="Rooms" asp-action="Table" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M8 3v10M3 8h10" />
        </svg>
        Ny booking
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h6 class="text-secondary mb-3">Kommende</h6>

@if (Model.Upcoming.Count == 0)
{
    <div class="card">
        <div class="card-body p-5 text-center">
            <p class="fw-semibold mb-1">Du har ingen kommende reservasjoner</p>
            <p class="text-secondary mb-4">Finn et ledig grupperom og book det på under et minutt.</p>
            <a asp-controller="Rooms" asp-action="Table" class="btn btn-primary">Finn rom</a>
        </div>
    </div>
}
else
{
    @foreach (var booking in Model.Upcoming)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title text-primary mb-1">Rom #@booking.RoomId – @booking.RoomBuilding</h5>
                    <p class="card-text text-secondary mb-0">
                        @booking.Date.ToString("dddd d. MMMM") · @booking.TimeSlot
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <form asp-controller="Bookings" asp-action="Cancel" asp-route-id="@booking.BookingId"
                          method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Avbestill</button>
                    </form>
                </div>
            </div>
        </div>
    }
}

<h6 class="text-secondary mt-5 mb-3">Tidligere</h6>

@if (Model.Past.Count == 0)
{
    <p class="text-secondary">Ingen tidligere reservasjoner.</p>
}
else
{
    @foreach (var booking in Model.Past)
    {
        <div class="card mb-3 bg-light">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title text-secondary mb-1">Rom #@booking.RoomId – @booking.RoomBuilding</h5>
                    <p class="card-text text-secondary mb-0 small">
                        @booking.Date.ToString("dddd d. MMMM yyyy") · @booking.TimeSlot
                    </p>
                </div>
                <span class="badge bg-secondary">Fullført</span>
            </div>
        </div>
    }
}
