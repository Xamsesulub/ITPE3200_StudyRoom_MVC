@model MVC.ViewModels.ReserveRoomViewModel
@{
    ViewData["Title"] = "Reserver rom";
}

<nav aria-label="Brødsmuler">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Table">Finn rom</a></li>
        <li class="breadcrumb-item active" aria-current="page">Reserver rom</li>
    </ol>
</nav>

<h1 class="mb-4">Reserver rom @Model.RoomId</h1>

<div class="row g-4">
    <div class="col-lg-8">
        @* Reload the page when the user chooses a date, so availability can be updated. *@
        <div class="card mb-4">
            <div class="card-body">
                <form asp-controller="Bookings" asp-action="Reserve" method="get"
                      class="row g-3 align-items-end">
                    <input type="hidden" name="id" value="@Model.RoomId" />
                    <div class="col-sm-6">
                        <label for="date" class="form-label fw-bold">Dato</label>
                        <input id="date" name="date" type="date"
                               value="@Model.Date.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-outline-primary">Vis ledige tider</button>
                    </div>
                </form>
            </div>
        </div>

        @* Send the selected time and booking details to the server for validation and saving. *@
        <form asp-controller="Bookings" asp-action="Reserve" method="post" class="card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="RoomId" />
                <input type="hidden" asp-for="Date" />

                <h2 class="h5 mb-3">Ledige tider @Model.Date.ToString("dd.MM.yyyy")</h2>
                <div class="mb-4">
                    @for (int i = 0; i < Model.Slots.Count; i++)
                    {
                        <input class="btn-check" type="radio" asp-for="SelectedSlot"
                               value="@Model.Slots[i].Value" id="slot@(i)"
                               disabled="@(!Model.Slots[i].IsAvailable)" autocomplete="off" />
                        <label class="btn @(Model.Slots[i].IsAvailable ? "btn-outline-primary" : "btn-outline-secondary disabled") me-2 mb-2"
                               for="slot@(i)">
                            @Model.Slots[i].Label@(Model.Slots[i].IsAvailable ? "" : " (opptatt)")
                        </label>
                    }
                    <span asp-validation-for="SelectedSlot" class="text-danger d-block"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="NumberOfPeople" class="form-label fw-bold"></label>
                        <input asp-for="NumberOfPeople" type="number" min="1"
                               max="@Model.RoomCapacity" class="form-control" />
                        <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Purpose" class="form-label fw-bold"></label>
                        <input asp-for="Purpose" class="form-control"
                               placeholder="For eksempel gruppearbeid" />
                        <span asp-validation-for="Purpose" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Bekreft reservasjon</button>
                <a asp-controller="Rooms" asp-action="Table" class="btn btn-link">Avbryt</a>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 text-primary">Rom @Model.RoomId</h2>
                <p>@Model.RoomBuilding, @Model.RoomFloor. etasje</p>
                <p class="mb-1"><strong>Kapasitet:</strong> @Model.RoomCapacity personer</p>
                <p class="mb-1"><strong>Skjerm:</strong> @(Model.RoomScreen ? "Ja" : "Nei")</p>
                <p class="mb-0"><strong>Whiteboard:</strong> @(Model.RoomWhiteboard ? "Ja" : "Nei")</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
